# Copy to .env and fill in. Placeholder values only - never commit a real .env.
#
# Local development (docker-compose.yml) works without a .env file: it uses the
# same local-only defaults shown in the first block.

# --- Local MySQL (docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=concert_db
MYSQL_USER=concert_user
MYSQL_PASSWORD=concert_password

# --- Backend ---
# HS512 signing key: at least 64 characters. Generate one with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-string-of-at-least-64-characters-change-me-please

# --- Frontend (Nuxt) ---
# URL the browser uses to reach the backend API
NUXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080
# Longdo Map API key for the event map (https://map.longdo.com/api); map is hidden if empty
NUXT_PUBLIC_LONGDO_MAP_KEY=

# --- Production (docker-compose.prod.yml) ---
RDS_ENDPOINT=your-db-instance.xxxxxxxxxxxx.ap-southeast-1.rds.amazonaws.com
RDS_USERNAME=admin
RDS_PASSWORD=change-me
AWS_REGION=ap-southeast-1
AWS_S3_EVENT_PICTURES_BUCKET=your-event-pictures-bucket
AWS_S3_USER_AVATARS_BUCKET=your-user-avatars-bucket
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
API_GATEWAY_URL=https://your-api-id.execute-api.ap-southeast-1.amazonaws.com
BACKEND_BASE_URL=http://backend:8080
