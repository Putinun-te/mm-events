# Copy to terraform.tfvars (git-ignored) and adjust. Every value here is optional:
# the defaults in variables.tf give a small two-node EKS cluster in Singapore.
# No secrets go in this file; the database password and JWT secret are generated.

# project            = "mm-events"
# region             = "ap-southeast-1"
# kubernetes_version = "1.34"            # null = current EKS default

# Strongly recommended: only your own IP may reach the Kubernetes API
# cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

# node_instance_types = ["t3.medium"]
# node_desired_size   = 2
# node_min_size       = 1
# node_max_size       = 3

# db_instance_class   = "db.t4g.micro"
# deletion_protection = false
