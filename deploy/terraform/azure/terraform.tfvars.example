# Copy to terraform.tfvars (git-ignored) and adjust.
# No secrets go in this file; the database password and JWT secret are generated.

# Required: the subscription to deploy into ('az account show --query id -o tsv')
subscription_id = "00000000-0000-0000-0000-000000000000"

# Optional
# name               = "mm-events"
# location           = "southeastasia"
# kubernetes_version = "1.34"            # null = current AKS default

# Strongly recommended: only your own IP may reach the Kubernetes API
# api_server_authorized_ip_ranges = ["203.0.113.10/32"]

# node_vm_size = "Standard_B2s"
# node_count   = 2
# db_sku       = "B_Standard_B1ms"
