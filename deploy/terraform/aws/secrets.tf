# JWT signing secret in Secrets Manager. The value is generated by an ephemeral resource and
# passed through a write-only argument, so it is stored in Secrets Manager but not in the
# Terraform state. Bump jwt_secret_version to rotate it.
# The database password secret is created by RDS (see database.tf).

ephemeral "random_password" "jwt" {
  length  = 96
  special = false
}

resource "aws_secretsmanager_secret" "jwt" {
  name                    = "${var.project}/jwt-secret"
  description             = "HS512 signing key for the MM Events API"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id                = aws_secretsmanager_secret.jwt.id
  secret_string_wo         = ephemeral.random_password.jwt.result
  secret_string_wo_version = 1
}
