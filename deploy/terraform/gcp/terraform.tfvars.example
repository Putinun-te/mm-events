# Copy to terraform.tfvars (git-ignored) and adjust.
# No secrets go in this file; the database password and JWT secret are generated.

# Required: an existing project with billing enabled
project_id = "your-gcp-project-id"

# Optional
# name   = "mm-events"
# region = "asia-southeast1"
# zone   = "asia-southeast1-a"

# Strongly recommended: only your own IP may reach the Kubernetes API
# master_authorized_networks = ["203.0.113.10/32"]

# node_machine_type   = "e2-medium"
# node_count          = 2
# db_tier             = "db-f1-micro"
# deletion_protection = false
